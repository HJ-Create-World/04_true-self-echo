{
  "name": "true-self-echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "真我回响 — 从素材出发，重放一个人的说话方式",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "acc": "node --experimental-strip-types EXP_acceptance.mjs",
    "electron:dev": "npm run build && node electron/build-backend.mjs && electron .",
    "electron:build": "npm run build && node electron/build-backend.mjs && electron-builder --win",
    "desktop:smoke": "node electron/build-backend.mjs && electron ."
  },
  "build": {
    "appId": "app.true.self.echo",
    "productName": "TrueSelfEcho",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "dist-server/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist-server/**",
      "dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "TrueSelfEcho-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TrueSelfEcho-Portable.exe"
    }
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.18.8",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.15",
    "vue-tsc": "^3.1.1"
  }
}
