# 真我回响 · 环境变量模板
#
# 用法：复制成 .env 再填值。.env 已被 .gitignore 排除，本文件可提交。
#
#   Windows PowerShell:  Copy-Item .env.example .env
#
# 决策依据：docs/02_decisions/D011-主基座与开销纪律.md

# ── 智谱 GLM（国内版）· 调 prompt 阶段的免费验证层 ──────────────
# 端点：国内版 open.bigmodel.cn；国际版是 api.z.ai
# ⚠️ 6000 万免费额度是有限资源，只用于调 prompt（D011 开销纪律 1）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6v

# ── DeepSeek · 主基座（跑正式数据）────────────────────────────
# ⚠️ 避峰：北京时间 周一至五 09:00-12:00 / 14:00-18:00 是 2 倍价
# ⚠️ 模型 ID 变更过：deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役
#    当前可用：deepseek-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── Ollama（本地，无需密钥）· 隐私兜底层 ──────────────────────
# ⚠️ 真人素材（朋友/亲人聊天记录）默认走这条，不上传第三方
#    依据：D011 决策一「四个坑」第 3 条（数据合规）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=deepseek-r1:latest

# ── 实验默认 ────────────────────────────────────────────────
# 主基座 = deepseek；调 prompt 时改回 glm（D011 开销纪律 1）
DEFAULT_PROVIDER=deepseek
